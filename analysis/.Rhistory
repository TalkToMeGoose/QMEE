# Optional: Analyze slopes for each group
group_slopes <- coef(model_group_learning)[grep("round", names(coef(model_group_learning)))]
group_slopes_df <- data.frame(
group_id = c("Overall", levels(data$group_id)[-1]),
slope = group_slopes
)
ggplot(group_slopes_df, aes(x = slope, y = reorder(group_id, slope))) +
geom_point() +
geom_vline(xintercept = 0, linetype = "dashed") +
labs(title = "Learning Rates by Group",
x = "Estimated Slope (Learning Rate)",
y = "Group ID") +
theme_minimal()
