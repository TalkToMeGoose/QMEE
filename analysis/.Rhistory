x = "Order of Rounds",
y = "Node Reached") +
theme_minimal()
View(personality_stats)
?glmm
?glmer
?glm
library(car)
# Assuming your data is in a dataframe called 'data'
# Ensure 'round' is numeric and 'treatment' is a factor
data2 <- data %>%
mutate(
round = as.numeric(round),
treatment = as.factor(treatment)
)
# Fit GLM with Poisson distribution
model_learning <- glm(node_reached ~ round * treatment,
data = data2, family = poisson)
# Check for overdispersion
dispersion_test <- sum(residuals(model_learning, type = "pearson")^2) / df.residual(model_learning)
print(paste("Dispersion parameter:", dispersion_test))
# If overdispersed (dispersion > 1.5), use quasipoisson
if (dispersion_test > 1.5) {
model_learning <- glm(node_reached ~ round * treatment,
data = data2, family = quasipoisson)
}
# Print model summary
summary(model_learning)
# ANOVA to test significance of effects
Anova(model_learning, type = "III")
# Visualize learning effects
ggplot(data2, aes(x = round, y = node_reached, color = treatment)) +
stat_summary(fun = mean, geom = "point") +
stat_summary(fun = mean, geom = "line") +
labs(title = "Learning Effects Across Rounds by Treatment",
x = "Round", y = "Average Node Reached") +
theme_minimal()
# Optional: Predict values for plotting
new_data <- expand_grid(
round = 1:max(data2$round),
treatment = unique(data2$treatment)
)
new_data$predicted <- predict(model_learning, newdata = new_data, type = "response")
# Plot with predicted lines
ggplot(data2, aes(x = round, y = node_reached, color = treatment)) +
geom_point(alpha = 0.3) +
geom_line(data = new_data, aes(y = predicted), size = 1) +
labs(title = "Learning Effects Across Rounds by Treatment",
x = "Round", y = "Node Reached") +
theme_minimal()
# ANOVA to test significance of effects
Anova(model_learning, type = "III")
data3 <- data %>%
arrange(participant_id, round) %>%
group_by(participant_id) %>%
mutate(
order = row_number(),
treatment = as.factor(treatment),
treatment_order = as.factor(treatment_order)  # Assuming you have this variable
) %>%
ungroup()
# Fit GLM with Poisson distribution
model_order <- glm(node_reached ~ order * treatment + treatment_order,
data = data3, family = poisson)
# Check for overdispersion
dispersion_test <- sum(residuals(model_order, type = "pearson")^2) / df.residual(model_order)
print(paste("Dispersion parameter:", dispersion_test))
# Print model summary
summary(model_order)
# ANOVA to test significance of effects
Anova(model_order, type = "III")
